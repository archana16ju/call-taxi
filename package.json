{
  "name": "calltaxi",
  "version": "1.0.0",
  "description": "A blank template to get started with Payload 3.0",
  "license": "MIT",
  "scripts": {
    "dev": "set NODE_OPTIONS=--no-deprecation && next dev",
    "build": "cross-env NODE_OPTIONS=\"--no-deprecation --max-old-space-size=8000\" npm run generate:importmap && next build",
    "devsafe": "rm -rf .next && cross-env NODE_OPTIONS=--no-deprecation next dev",
    "generate:importmap": "cross-env NODE_OPTIONS=\"--no-deprecation --import tsx\" payload generate:importmap && node scripts/fix-importmap.cjs",
    "generate:types": "cross-env NODE_OPTIONS=--no-deprecation payload generate:types",
    "lint": "cross-env NODE_OPTIONS=--no-deprecation next lint",
    "payload": "cross-env NODE_OPTIONS=--no-deprecation payload",
    "start": "cross-env NODE_OPTIONS=--no-deprecation next start",
    "test": "pnpm run test:int && pnpm run test:e2e",
    "test:e2e": "cross-env NODE_OPTIONS=\"--no-deprecation --no-experimental-strip-types\" pnpm exec playwright test",
    "test:int": "cross-env NODE_OPTIONS=--no-deprecation vitest run --config ./vitest.config.mts",
    "fix:imports": "node scripts/auto-fix-imports.cjs"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/icons-material": "^7.3.10",
    "@mui/material": "^7.3.10",
    "@mui/x-date-pickers": "^8.16.0",
    "@payloadcms/db-mongodb": "^3.68.5",
    "@payloadcms/next": "^3.84.1",
    "@payloadcms/payload-cloud": "^3.68.5",
    "@payloadcms/richtext-lexical": "^3.84.1",
    "@payloadcms/storage-vercel-blob": "^3.68.5",
    "@payloadcms/ui": "^3.68.5",
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.5.0",
    "@types/lodash": "^4.17.21",
    "axios": "^1.13.1",
    "cross-env": "^7.0.3",
    "date-fns": "^4.1.0",
    "dayjs": "^1.11.19",
    "dotenv": "^16.4.7",
    "firebase-admin": "^13.0.0",
    "framer-motion": "^12.23.24",
    "graphql": "^16.12.0",
    "leaflet": "^1.9.4",
    "lodash": "^4.17.21",
    "lucide-react": "^0.562.0",
    "next": "^15.5.15",
    "payload": "^3.84.1",
    "qrcode.react": "^4.2.0",
    "razorpay": "^2.9.6",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "react-hook-form": "^7.66.0",
    "react-leaflet": "^5.0.0",
    "recharts": "^3.8.1",
    "sharp": "^0.34.5",
    "three": "^0.181.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.57.0",
    "@tailwindcss/postcss": "^4.2.4",
    "@testing-library/react": "16.3.0",
    "@types/leaflet": "^1.9.21",
    "@types/node": "^22.19.17",
    "@types/react": "19.1.8",
    "@types/react-dom": "19.1.6",
    "@types/react-leaflet": "^2.8.3",
    "autoprefixer": "^10.5.0",
    "eslint": "^10.3.0",
    "postcss": "^8.5.14",
    "tailwindcss": "^3.4.17",
    "typescript": "6.0.3"
  }
}
